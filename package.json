{
  "name": "@sume-com/open",
  "version": "0.2.0",
  "description": "Images and video from the Sume Open API: one call to run any open.sume.com model and save the file. Server-side.",
  "keywords": [
    "sume",
    "open.sume.com",
    "image-generation",
    "video-generation",
    "lipsync",
    "generative-media",
    "ai",
    "sdk"
  ],
  "homepage": "https://github.com/sumelabs/sume-js#readme",
  "bugs": {
    "url": "https://github.com/sumelabs/sume-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumelabs/sume-js.git"
  },
  "license": "MIT",
  "author": "Sume Labs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/browser.js",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/finish-build.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/check-readme.mjs && node scripts/smoke-package.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
