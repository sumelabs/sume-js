{
  "name": "@sume-com/client",
  "version": "0.3.0",
  "description": "Official Sume SDK for Node.js and TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "default": "./dist/v2/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "v2": [
        "./dist/v2/index.d.ts"
      ]
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:prod": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.prod.json",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "npm run build:prod",
    "prepublishOnly": "npm run build:prod && npm run test"
  },
  "keywords": [
    "sume",
    "open.sume.com",
    "ai",
    "api",
    "client",
    "sdk",
    "typescript",
    "image-generation",
    "video-generation"
  ],
  "author": "Sume Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumelabs/sume-js.git"
  },
  "bugs": {
    "url": "https://github.com/sumelabs/sume-js/issues"
  },
  "homepage": "https://open.sume.com/docs",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.0",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
